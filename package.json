{
  "name": "banana-chat",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./apps/web/node_modules/.bin/vite --host 127.0.0.1 --config apps/web/vite.config.ts apps/web",
    "dev:api": "cd apps/api && php artisan serve --host=127.0.0.1 --port=8000",
    "dev:mobile": "cd apps/mobile && ./node_modules/.bin/expo start",
    "build": "npm run typecheck --silent && ./apps/web/node_modules/.bin/vite build apps/web --config apps/web/vite.config.ts",
    "build:turbo": "turbo build --filter=!@banana/mobile",
    "typecheck": "./node_modules/.bin/tsc -p packages/shared/tsconfig.json && ./node_modules/.bin/tsc -p packages/api-client/tsconfig.json && ./node_modules/.bin/tsc -p packages/chat-core/tsconfig.json && ./node_modules/.bin/tsc -p apps/web/tsconfig.json",
    "typecheck:mobile": "./node_modules/.bin/tsc -p apps/mobile/tsconfig.json",
    "test": "vitest run",
    "test:api": "cd apps/api && php artisan test",
    "test:e2e": "playwright test",
    "gen:client": "openapi-typescript openapi.yaml -o packages/api-client/src/generated.ts",
    "check": "npm run typecheck --silent && npm run typecheck:mobile --silent && npm run test --silent && npm run test:api --silent && npm run build --silent"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.1",
    "@types/node": "^22.15.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.21",
      "postcss": ">=8.5.23",
      "@xmldom/xmldom": ">=0.8.15",
      "uuid": ">=11.1.1",
      "decode-uri-component": ">=0.5.0"
    }
  }
}
